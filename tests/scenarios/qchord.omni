# the Q Chord's controls: EZ PLAY, AUTO CHORD, CHORD PLUS, REVERB, VIBRATO, the voices, the bend
wav qchord.wav
wait 200
# EZ PLAY (REC) is on from the start: a chord button sounds its chord, no bass, no rhythm
expect par22 1
key b1 down
wait 100
expect chord_level >50
expect bass_level 0
strum 0 15 25
wait 300
shot ez.png
# CHORD PLUS (ENV) by hand: the bass comes in, with the chord an octave up
tap ENV
expect par24 1
wait 100
expect bass_level >50
tap ENV
expect par24 0
wait 600
expect bass_level 0
# AUTO CHORD (SEL) off: the buttons only change the strum plate
tap SEL
expect par23 0
wait 500
expect chord_level 0
key b1 up
key b4 down
wait 50
expect root 9
expect chord_level 0
strum 0 15 25
key b4 up
tap SEL
expect par23 1
# REVERB (FX) and VIBRATO (GLO)
tap FX
expect par26 0
tap FX
expect par26 1
tap GLO
expect par25 1
shot toggles.png
leds
# the voices: the strum plate on Vibes (KNOB 1), the chord on Strings (KNOB 2)
spin K1 9
expect par0 9
spin K2 35
expect par1 35
wait 50
shot voices.png
key b1 down
wait 200
expect chord_level >50
strum 0 15 25
wait 200
# the bend (KNOB 4 on the Play page): turned, it bends; let go, it comes back
expect view 0
turn K4 3 20
wait 20
expect bend >50
shot bend.png
wait 400
expect bend 0
key b1 up
# PRESETS: the sustain; SELECT: the chord set (all minor: C minor on the 5th black key, the circle of fifths)
spin PRESET -50
expect par3 0
spin PRESET 50
expect par3 50
turn SELECT 2 200
expect chordset 2
key b4 down
wait 50
expect root 0
expect type 1
shot chordset.png
key b4 up
turn SELECT 6 100
expect chordset 8
key b0 down
wait 50
expect root 8
expect type 9
key b0 up
turn SELECT -9 100
expect chordset 0
# KNOB 4 on another page is that page's own (Mix: Bass vol)
tap EDIT
spin K4 -10
expect par7 50
expect bend 0
tap HOME
wait 1000
# EZ PLAY off, the rhythm with CHORD PLUS's figure
tap REC
expect par22 0
tap ENV
key b1 down
tap PLAY
expect playing 1
wait 2500
key b1 up
tap PLAY
expect playing 0
# EZ PLAY on while it plays: the rhythm stops
tap PLAY
expect playing 1
tap REC
wait 50
expect playing 0
expect par22 1
wait 500
wavstop
expect peak_db_max -0.1
expect peak_db_min -30
# LFO: the Sustain page. A key held down rings on whatever the sustain; let go, the sustain is its fade
tap LFO
expect view 6
spin K1 -50
expect par3 0
key w5 down
wait 2000
expect strlevel5 >50
key w5 up
wait 600
expect strlevel5 0
spin K2 70
expect par20 100
key b1 down
wait 2000
expect chord_level >50
key b1 up
wait 1000
expect chord_level >50
spin K2 -100
wait 3000
key b1 down
wait 100
key b1 up
wait 300
expect chord_level 0
shot sustainpage.png
tap LFO
expect view 0
