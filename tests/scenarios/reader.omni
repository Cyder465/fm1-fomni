# the screen reader (fm1-reader, announce.c): a reader listens, and each page, knob, chord, button and
# transport change is said once, in the screen's own text (the words file says it in full)
wait 200
listen
wait 100
said Play page: Strum Omni 1, Chord Omni 1, Plus Piano, Bend 0.0. Chord C major. Rhythm Rock 1, tempo 116, stopped. EZ Play on
# a page settles before it is said
tap EDIT
wait 300
said Mix page: Strum vol 80, Chord vol 60, Drum vol 70, Bass vol 60
tap EDIT
wait 300
said Rhythm page: Rhythm Rock 1, Tempo 116, Bass On, Sync start Off
tap EDIT
tap EDIT
tap EDIT
wait 300
said Setup page: Tune 0, MIDI out On, Lights On, Bend 2
# a knob: its name and value, once it settles
spin K1 3
wait 300
said Tune +3
# the encoders
turn SELECT 2 200
wait 300
said KEY D (+2)
turn SELECT -2 200
wait 300
said KEY C
turn PRESET 1
wait 300
said SUSTAIN 51
turn ALGO 1
wait 300
said Rhythm Rock 2
# a voice, by name
tap HOME
wait 300
spin K1 9
wait 300
said Strum Vibes
# a chord button: its chord, at once (ENV held: the minor)
key b1 down
wait 50
said C major
key b1 up
press ENV
key b2 down
wait 50
said G minor
key b2 up
release ENV
wait 100
# the buttons' messages, said once
tap REC
said EZ PLAY OFF
tap SEQ
said AUTO CHORD OFF
tap SEQ
said AUTO CHORD ON
tap SEL
said CHORD PLUS ON
tap SEL
said CHORD PLUS OFF
tap FX
said REVERB OFF
tap FX
said REVERB ON
tap GLO
said VIBRATO ON
tap GLO
said VIBRATO OFF
tap ARP
said CHORD HOLD ON
tap ARP
said CHORD HOLD OFF
# the transport
tap PLAY
wait 50
said Play
tap PLAY
wait 50
said Stop
tap OCT+
wait 300
said OCTAVE +1
tap OCT-
wait 300
tap SAVE
said SAVED
# the CHORDS page: the button pressed, then a knob on it
tap EDIT
tap EDIT
tap EDIT
tap EDIT
key b6 down
key b6 up
wait 300
said Chords page, button 7: Root G, Type 7
spin K2 1
wait 300
said Type major 7
# a chord from MIDI, channel 2
midi 91 3C 64
midi 91 40 64
midi 91 43 64
wait 50
said C major
midi 81 3C 00
midi 81 40 00
midi 81 43 00
# WHERE: everything again
where
said Chords page, button 7
