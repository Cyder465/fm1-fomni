# chord buttons, the chord sets (SELECT), CHORD HOLD, SYNC START, saving
wait 200
# F (button 0) as set; the 7th set (SELECT 3): F7 on the 4th button (the circle of fifths: Ab Eb Bb F ...)
tapkey b0
expect root 5
expect type 0
turn SELECT 3 100
expect chordset 3
tapkey b3
expect root 5
expect type 2
expect view 0
# the strings follow the chord: F7 is F A Eb, F3 A3 Eb3 on strings 0..2 (Eb folded up to F#2..F3)
expect strnote0 53
expect strnote1 45
expect strnote2 51
turn SELECT -3 100
expect chordset 0
# without HOLD the chord stops when let go
tapkey b1
wait 400
expect chord_level 0
# CHORD HOLD: it keeps going; the same button again stops it
tap ARP
expect hold 1
tapkey b2
wait 400
expect chord_level >50
expect pad 2
tapkey b2
wait 400
expect chord_level 0
expect pad -1
tap ARP
expect hold 0
# SYNC START (the Rhythm page's KNOB 4): PLAY leaves EZ PLAY and waits for a chord
tap EDIT
tap EDIT
expect view 2
spin K4 1
expect sync 1
tap PLAY
expect par22 0
expect armed 1
expect playing 0
wait 100
key b3 down
wait 20
expect playing 1
expect armed 0
key b3 up
tap PLAY
expect playing 0
# OCT+ moves the plate up
tap OCT+
expect par16 1
tap OCT-
expect par16 0
# the CHORDS page: transpose +2 on KNOB 3; press a button, change its chord
tap HOME
tap EDIT
tap EDIT
tap EDIT
tap EDIT
expect view 4
spin K3 2
expect par15 2
tapkey b10
spin K1 -2
spin K2 -2
expect padroot10 7
expect padtype10 0
shot chords.png
# it saves by itself when quiet, and comes back after a restart
wait 5000
expect dirty 0
reboot
wait 100
expect padroot10 7
expect par15 2
expect sync 1
expect par22 0
shot after_reboot.png
